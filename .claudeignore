# .claudeignore — Boreas BlueOS
#
# Файлы и директории, которые ИИ-агент НЕ должен читать или индексировать
# при автономной работе. Цель: не сжигать контекстное окно на бинарники,
# кэши и сгенерированные артефакты, которые не несут архитектурной информации.

# --- Python build/cache artifacts ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test / lint / type-check caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Git internals ---
.git/

# --- Logs and runtime dumps ---
*.log
*.log.*
logs/
*.dump
*.core

# --- Large binary / data artifacts (not expected in this repo, defensive) ---
*.pt
*.onnx
*.h5
*.tar.gz
*.zip
*.bin
*.hef
node_modules/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Session-local scratch state (see state_journal.md for the durable log) ---
todo_temp.md
